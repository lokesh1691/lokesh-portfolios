# Copy this file to .env and fill in real values. NEVER commit the real .env file.

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (your deployed frontend URL(s))
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# JWT auth (admin login)
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=15m
COOKIE_SECRET=replace-with-a-different-long-random-string

# Admin credentials — generate the hash with: npm run hash-password
ADMIN_USERNAME=lokesh
ADMIN_PASSWORD_HASH=paste-the-bcrypt-hash-here

# Rate limiting
CONTACT_RATE_LIMIT_MAX=5        # max contact submissions per IP per window
CONTACT_RATE_LIMIT_WINDOW_MIN=15
LOGIN_RATE_LIMIT_MAX=5          # max login attempts per IP per window
LOGIN_RATE_LIMIT_WINDOW_MIN=15
GLOBAL_RATE_LIMIT_MAX=100       # max requests per IP per window, all routes
GLOBAL_RATE_LIMIT_WINDOW_MIN=1
